# PostgreSQL connection (development)
DATABASE_URL=postgresql://metrookeh:metrookeh@localhost:5432/metrookeh
COMPOSE_PROJECT_NAME=metrookeh

# Dev seed admin only — never use in production
SEED_ADMIN_PASSWORD=change-me-in-dev
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Administrator

# Web session signing secret (required for apps/web)
AUTH_SECRET=dev-only-change-me-to-a-long-random-string
