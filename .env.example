COMPOSE_PROJECT_NAME=metrookeh

# Postgres (used by Docker Compose; change passwords before production/LAN deploy)
POSTGRES_USER=metrookeh
POSTGRES_PASSWORD=metrookeh
POSTGRES_DB=metrookeh
POSTGRES_PORT=5432

# Host-side Node (npm run dev / migrate from laptop) — use localhost
DATABASE_URL=postgresql://metrookeh:metrookeh@localhost:5432/metrookeh

# Web container port on the host / LAN
WEB_PORT=3000

# Session signing secret (required). Use a long random string (≥32 chars) on servers.
AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# First-boot admin seed (skipped automatically if username already exists)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-in-dev
SEED_ADMIN_DISPLAY_NAME=Administrator
# Set to 1 only when you intentionally want to reset the admin password on seed
SEED_ADMIN_RESET=0
